# Deployed with the site (Vite copies public/ into dist/).
#
# index.html must always be fetched fresh: it names the current build's script files
# (assets/index-<hash>.js). If a cache keeps serving an old index.html after a deploy,
# it points to files that no longer exist and the page stays blank.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Build files have a content hash in their name, so they never change and can be cached long.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
