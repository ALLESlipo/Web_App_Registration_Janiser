# Registrations go to the nutriminds-survey WordPress plugin on nutriminds.net.
# Copy to .env.local (development) or .env.production.local (build) and fill in.
# Leave either value empty to run the form in demo mode (nothing is sent).

# Production:
VITE_REGISTRATION_ENDPOINT=https://nutriminds.net/wp-json/nms/v1/register
# ID of the "TRD-2-STUDY26/27" project (NutriMinds Survey → Projects in wp-admin).
VITE_NMS_PROJECT_ID=698

# Local WordPress (http://localhost:8088) — the local project ID differs:
# VITE_REGISTRATION_ENDPOINT=http://localhost:8088/wp-json/nms/v1/register
# VITE_NMS_PROJECT_ID=154
